# aster - Environment Variables
# Copy this file to .env and fill in your API keys

# LiteLLM proxy (STT/LLM/TTS all go through it)
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm.jpabreu.com/v1

# Model names as exposed by LiteLLM
LLM_MODEL=lfm-2.5-24b-a2b
STT_MODEL=nvidia/parakeet-tdt-0.6b-v3
TTS_MODEL=drama3
