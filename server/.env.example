# aster - Environment Variables
# Copy this file to .env and fill in your API keys

# LLM: proxy LiteLLM
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm.jpabreu.com/v1
LLM_MODEL=lfm-2.5-24b-a2b

# STT y TTS: OpenRouter directo (no pasan por LiteLLM)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
STT_MODEL=nvidia/parakeet-tdt-0.6b-v3
TTS_MODEL=drama-3
TTS_VOICE=alloy
